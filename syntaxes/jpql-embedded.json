{
  "scopeName": "source.jpql.embedded.java",
  "injectionSelector": "L:source.java",
  "patterns": [
    {
      "name": "meta.embedded.sql",
      "begin": "(@NativeQuery\\s*\\(\\s*(?:value\\s*=\\s*)?)(\"\"\"|\")",
      "beginCaptures": {
        "1": { "name": "entity.name.function.annotation.java" },
        "2": { "name": "punctuation.definition.string.begin.java" }
      },
      "end": "(\"\"\"|(?<!\\\\)\")",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.java" } },
      "patterns": [{ "include": "#sql" }]
    },
    {
      "name": "meta.embedded.sql",
      "begin": "(@Query\\s*\\(\\s*nativeQuery\\s*=\\s*true\\s*,\\s*(?:value\\s*=\\s*)?)(\"\"\"|\")",
      "beginCaptures": {
        "1": { "name": "entity.name.function.annotation.java" },
        "2": { "name": "punctuation.definition.string.begin.java" }
      },
      "end": "(\"\"\"|(?<!\\\\)\")",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.java" } },
      "patterns": [{ "include": "#sql" }]
    },
    {
      "name": "meta.embedded.sql",
      "begin": "(@Query\\s*\\(\\s*(?=(?:(?:\"\"\"[\\s\\S]*?\"\"\"|\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*')|[^)])*\\bnativeQuery\\s*=\\s*true\\b)(?:value\\s*=\\s*)?)(\"\"\"|\")",
      "beginCaptures": {
        "1": { "name": "entity.name.function.annotation.java" },
        "2": { "name": "punctuation.definition.string.begin.java" }
      },
      "end": "(\"\"\"|(?<!\\\\)\")",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.java" } },
      "patterns": [{ "include": "#sql" }]
    },
    {
      "name": "meta.embedded.jpql",
      "begin": "(@Query\\s*\\(\\s*(?:value\\s*=\\s*)?)(\"\"\"|\")",
      "beginCaptures": {
        "1": { "name": "entity.name.function.annotation.java" },
        "2": { "name": "punctuation.definition.string.begin.java" }
      },
      "end": "(\"\"\"|(?<!\\\\)\")",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.java" } },
      "patterns": [
        {
          "name": "keyword.control.jpql",
          "match": "\\b(?:SELECT|FROM|WHERE|JOIN|LEFT|RIGHT|FULL|INNER|OUTER|CROSS|FETCH|GROUP|BY|HAVING|ORDER|ASC|DESC|UPDATE|DELETE|SET|AS)\\b"
        },
        {
          "name": "keyword.operator.jpql",
          "match": "\\b(?:AND|OR|NOT|IN|BETWEEN|LIKE|IS|NULL|EMPTY|MEMBER|OF|EXISTS|ALL|ANY|SOME)\\b|<>|<=|>=|=|<|>|\\+|\\-|\\*|/"
        },
        {
          "name": "support.function.jpql",
          "match": "\\b(?:AVG|COUNT|MAX|MIN|SUM|CONCAT|SUBSTRING|LOWER|UPPER|TRIM|LENGTH|LOCATE|REPLACE|LEFT|RIGHT|ABS|MOD|SQRT|CEILING|EXP|FLOOR|LN|POWER|ROUND|SIGN|CURRENT_DATE|CURRENT_TIME|CURRENT_TIMESTAMP|LOCAL_DATE|LOCAL_TIME|LOCAL_DATETIME|EXTRACT|SIZE|INDEX|KEY|VALUE|ENTRY|TYPE|TREAT|FUNCTION)\\b(?=\\s*\\()"
        },
        {
          "match": "\\b(FROM|JOIN)\\s+([A-Z][A-Za-z0-9_$]*)",
          "captures": {
            "1": { "name": "keyword.control.jpql" },
            "2": { "name": "entity.name.type.jpql" }
          }
        },
        {
          "match": "\\b(?:FROM|JOIN)\\s+[A-Z][A-Za-z0-9_$]*(?:\\s+AS)?\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": { "1": { "name": "variable.other.alias.jpql" } }
        },
        { "name": "variable.parameter.jpql", "match": ":[A-Za-z_$][A-Za-z0-9_$]*" },
        { "name": "constant.language.jpql", "match": "\\b(?:TRUE|FALSE)\\b" },
        { "name": "string.quoted.jpql", "match": "'(?:[^'\\\\]|\\\\.)*'" },
        { "name": "constant.numeric.jpql", "match": "\\b\\d+(?:\\.\\d+)?\\b" },
        {
          "name": "variable.other.property.jpql",
          "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*\\.([A-Za-z_$][A-Za-z0-9_$]*)\\b"
        }
      ]
    }
  ],
  "repository": {
    "sql": {
      "patterns": [
        { "name": "comment.block.sql", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.line.double-dash.sql", "match": "--.*$" },
        {
          "name": "string.quoted.single.sql",
          "begin": "'",
          "end": "'",
          "patterns": [{ "match": "''" }]
        },
        {
          "name": "string.quoted.double.sql",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "match": "\"\"" }]
        },
        {
          "name": "string.quoted.backtick.sql",
          "begin": "`",
          "end": "`",
          "patterns": [{ "match": "``" }]
        },
        { "name": "entity.name.identifier.sql", "match": "\\[[^]\\r\\n]+\\]" },
        {
          "name": "variable.parameter.sql",
          "match": ":[A-Za-z_$][A-Za-z0-9_$]*|\\?(?:\\d+)?|\\$\\d+"
        },
        {
          "name": "keyword.control.sql",
          "match": "\\b(?:SELECT|DISTINCT|FROM|WHERE|JOIN|LEFT|RIGHT|FULL|INNER|OUTER|CROSS|ON|USING|AS|AND|OR|NOT|IN|IS|NULL|LIKE|ILIKE|BETWEEN|EXISTS|GROUP|BY|HAVING|ORDER|ASC|DESC|LIMIT|OFFSET|FETCH|FIRST|NEXT|ROWS|ONLY|TOP|RETURNING|INSERT|INTO|UPDATE|SET|DELETE|MERGE|WHEN|THEN|ELSE|END|CASE|WITH|RECURSIVE|UNION|INTERSECT|EXCEPT|ALL|ANY|CREATE|ALTER|DROP|TABLE|VIEW|INDEX|PRIMARY|FOREIGN|KEY|REFERENCES|CONSTRAINT|UNIQUE|CHECK|DEFAULT|DATABASE|SCHEMA|BEGIN|COMMIT|ROLLBACK|TRANSACTION|OVER|PARTITION|WINDOW|NULLS|PRECEDING|FOLLOWING|CURRENT|ROW)\\b"
        },
        { "name": "constant.language.sql", "match": "\\b(?:TRUE|FALSE|UNKNOWN)\\b" },
        { "name": "support.function.sql", "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*\\b(?=\\s*\\()" },
        {
          "name": "entity.name.table.sql",
          "match": "\\b(?:FROM|JOIN|INTO|UPDATE|TABLE)\\s+([A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*)",
          "captures": { "1": { "name": "entity.name.table.sql" } }
        },
        {
          "name": "variable.other.column.sql",
          "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*\\.([A-Za-z_$][A-Za-z0-9_$]*)\\b",
          "captures": { "1": { "name": "variable.other.column.sql" } }
        },
        { "name": "constant.numeric.sql", "match": "\\b\\d+(?:\\.\\d+)?\\b" },
        { "name": "keyword.operator.sql", "match": "::|<>|!=|<=|>=|=|<|>|\\+|\\-|\\*|/|%" }
      ]
    }
  }
}