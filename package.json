{
  "name": "spring-jpa-autocomplete",
  "displayName": "Spring JPA Autocomplete",
  "publisher": "houssam-ouatmani",
  "description": "Autocomplete Spring Data JPA query methods, entity properties, operators, and sort modifiers in Java repositories.",
  "version": "0.0.1",
  "icon": "thumbnail.png",
  "galleryBanner": {
    "color": "#0b1f3a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "spring",
    "spring data",
    "spring data jpa",
    "jpa",
    "hibernate",
    "java",
    "repository",
    "autocomplete",
    "derived query",
    "findby"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Houssam-OUATMANI/spring-jpa-autocomplete.git"
  },
  "homepage": "https://github.com/Houssam-OUATMANI/spring-jpa-autocomplete#readme",
  "bugs": {
    "url": "https://github.com/Houssam-OUATMANI/spring-jpa-autocomplete/issues"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "contributes": {
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
